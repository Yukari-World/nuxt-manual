arrowParens: always
printWidth: 120
semi: true
singleQuote: true
tabWidth: 4
useTabs: true
plugins:
  - "@prettier/plugin-pug"
pugAttributeSeparator: "always"
pugCommentPreserveSpaces: true
pugIdMode: "id"
pugSortAttributes: "as-is"

overrides:
  - files: "*.js"
    options:
      parser: babel
      trailingComma: all
  - files: "*.scss"
    options:
      parser: scss
      singleQuote: false
  - files: "*.vue"
    options:
      parser: vue
  - files: "*.yml"
    options:
      tabWidth: 2
      useTabs: false
